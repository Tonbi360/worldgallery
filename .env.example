# ==============================================================================
# WORLD GALLERY — CANONICAL ENVIRONMENT VARIABLES
# ==============================================================================

# Serverless Database (Neon PostgreSQL) - REQUIRED
DATABASE_URL="postgresql://user:password@ep-sample-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require"

# Serverless Curator Authentication - REQUIRED ON SERVER
ADMIN_EMAIL="curator@worldgallery.org"
ADMIN_PASSCODE="your_curator_secret_passcode"

# Client-Side Curator Identity (Vite Browser Runtime) - REQUIRED ON CLIENT
VITE_ADMIN_EMAIL="curator@worldgallery.org"

# Canonical Production URL (Optional)
APP_URL="https://your-deployment-name.vercel.app"
VITE_APP_URL="https://your-deployment-name.vercel.app"

# Transactional Email Dispatch (Resend API) - OPTIONAL
RESEND_API_KEY="re_sample_api_key"

# Creator Ko-fi Support Link (Optional — if unset, Ko-fi row is completely hidden)
VITE_KOFI_URL=""

